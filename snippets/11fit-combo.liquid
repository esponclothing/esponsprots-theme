{% assign price_per_item = combo_price | divided_by: combo_count %}
{% assign regular_total_cents = product.price | times: combo_count %}
{% assign regular_total = regular_total_cents | divided_by: 100.0 %}
{% assign total_saved = regular_total | minus: combo_price %}

<div class="fit11-offer-card" style="margin: 16px 0; width: 100%; min-width: 100%; border-color: #ffdf00; cursor: default; flex-direction: column; padding: 16px;">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
    <div class="fit11-offer-code" style="font-size: 14px; font-weight: 600; color: #1a202c;">{{ combo_count }} COMBO OFFER</div>
    <div style="background: #198754; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase;">Deal Applied</div>
  </div>
  <div class="fit11-offer-desc" style="font-size: 13px; color: #1a202c; font-weight: 500; margin-top: 4px;">
    {{ combo_count }} {{ product.title | escape }} at <span style="color: #198754; font-weight: 700;">Rs.{{ price_per_item | round }} Each</span>
  </div>
  <div class="fit11-offer-desc" style="font-weight: 600; color: #d9480f; margin-top: 6px; font-size: 13px;">
    <i class="ti ti-flame"></i> You Saved ₹{{ total_saved | round }} Instantly!
  </div>
  <div style="border-top: 1px dashed #cbd5e0; margin-top: 12px; padding-top: 10px; display: flex; justify-content: space-between; font-size: 11px; font-weight: 500; color: #718096;">
    <span style="color: #198754; display: flex; align-items: center; gap: 4px;"><i class="ti ti-truck"></i> Free Delivery</span>
    <span>No Coupon Needed</span>
  </div>
</div>

<div style="background: #e6efff; border-radius: 4px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
  <span style="font-size: 13px; font-weight: 500; color: #1a1a1a;">Additional Prepaid Discount At Checkout</span>
  <div style="display: flex; gap: 6px; align-items: center;">
    <img src="https://cdn.shopify.com/s/files/1/0805/0196/5080/files/PhonePe_Logo.svg?v=1718017004" onerror="this.style.display='none'" alt="PhonePe" style="height: 18px;">
    <img src="https://cdn.shopify.com/s/files/1/0805/0196/5080/files/Google_Pay_Logo.svg?v=1718017004" onerror="this.style.display='none'" alt="GPay" style="height: 18px;">
    <img src="https://cdn.shopify.com/s/files/1/0805/0196/5080/files/Paytm_Logo.svg?v=1718017004" onerror="this.style.display='none'" alt="Paytm" style="height: 18px;">
  </div>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
  <div style="font-weight: 600; font-size: 15px; color: #1a1a1a;">Select Combo</div>
  <div onclick="fit11ToggleModal(true)" style="font-size: 13px; font-weight: 500; color: #1a1a1a; cursor: pointer; display: flex; align-items: center; gap: 4px;">Size Guide <i class="ti ti-chevron-right" style="font-size: 12px;"></i></div>
</div>

<div class="fit11-combo-selectors" style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 24px;">
  {% for i in (1..combo_count) %}
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <!-- Color Select -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label style="font-size: 14px; font-weight: 500; color: #1a1a1a; margin: 0;">Color {{ i }}</label>
        <div style="position: relative;">
          <select id="combo-color-{{ i }}" class="combo-select combo-color-select" data-item="{{ i }}" data-option="color" onchange="updateComboSelection({{ i }}, 'color', this.value)" style="width: 100%; appearance: none; -webkit-appearance: none; padding: 12px 14px; border: 1px solid #d0d0d0; border-radius: 4px; font-size: 14px; color: #1a1a1a; background: #fff; outline: none; cursor: pointer; font-family: inherit;">
            <option value="" disabled selected>Select</option>
            {% for option in product.options_with_values %}
              {% assign option_name_lower = option.name | downcase %}
              {% if option_name_lower contains 'color' or option_name_lower contains 'colour' %}
                {% for value in option.values %}
                  {% assign val_avail = false %}
                  {% for variant in product.variants %}
                    {% if variant.available and variant.options contains value %}
                      {% assign val_avail = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if val_avail %}
                    <option value="{{ value | escape }}">{{ value }}</option>
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          </select>
          <svg style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="#666666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      
      <!-- Size Select -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <label style="font-size: 14px; font-weight: 500; color: #1a1a1a; margin: 0;">Size {{ i }}</label>
          {% if i == 1 %}
          <label style="font-size: 12px; color: #198754; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px; margin: 0;">
            <input type="checkbox" id="combo-sync-size-checkbox" onchange="syncComboSizes()" style="accent-color: #198754; margin: 0; cursor: pointer; width: 14px; height: 14px;" checked> Same for all
          </label>
          {% endif %}
        </div>
        <div style="position: relative;">
          <select id="combo-size-{{ i }}" class="combo-select combo-size-select" data-item="{{ i }}" data-option="size" onchange="updateComboSelection({{ i }}, 'size', this.value)" style="width: 100%; appearance: none; -webkit-appearance: none; padding: 12px 14px; border: 1px solid #d0d0d0; border-radius: 4px; font-size: 14px; color: #1a1a1a; background: #fff; outline: none; cursor: pointer; font-family: inherit;">
            <option value="" disabled selected>Select Size</option>
            {% for option in product.options_with_values %}
              {% assign option_name_lower = option.name | downcase %}
              {% if option_name_lower contains 'size' %}
                {% for value in option.values %}
                  {% assign val_avail = false %}
                  {% for variant in product.variants %}
                    {% if variant.available and variant.options contains value %}
                      {% assign val_avail = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if val_avail %}
                    <option value="{{ value | escape }}">{{ value }}</option>
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          </select>
          <svg style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L5 5L9 1" stroke="#666666" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<div class="fit11-main-buttons-container">
  <button type="button" class="fit11-btn-cart" id="fit11ComboAddToCartBtn" style="width: 100%; margin: 0 !important; background: #222 !important; color: #fff !important; border-radius: 6px; border: none; font-weight: 600; font-size: 14px; height: 50px !important; display: flex; align-items: center; justify-content: center; gap: 8px;" onclick="addComboToCart(event)" disabled>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
    <span class="fit11-btn-text">ADD TO CART</span>
  </button>
</div>
<div class="fit11-original-buttons-anchor"></div>

<script>
  let comboSelections = {};

  function decodeHTML(html) {
    if (!html) return '';
    var txt = document.createElement('textarea');
    txt.innerHTML = html;
    return txt.value;
  }

  function updateDynamicAvailableOptions(itemIndex) {
    let variantsDataEl = document.getElementById('ProductVariantsData');
    if (!variantsDataEl) return;
    let variants = [];
    try { variants = JSON.parse(variantsDataEl.textContent); } catch(e) { return; }

    const availVariants = variants.filter(v => v.available === true);
    const selColorEl = document.getElementById('combo-color-' + itemIndex);
    const selSizeEl = document.getElementById('combo-size-' + itemIndex);

    const selectedColor = selColorEl ? selColorEl.value : null;
    const selectedSize = selSizeEl ? selSizeEl.value : null;

    if (selectedColor && selSizeEl) {
      const cVal = decodeHTML(selectedColor).trim().toLowerCase();
      const validSizes = new Set();
      availVariants.forEach(v => {
        let vOpts = (v.options || []).map(o => decodeHTML(o).trim().toLowerCase());
        if (vOpts.some(o => o === cVal || o.includes(cVal))) {
          vOpts.forEach(o => validSizes.add(o));
          if (v.option1) validSizes.add(decodeHTML(v.option1).trim().toLowerCase());
          if (v.option2) validSizes.add(decodeHTML(v.option2).trim().toLowerCase());
          if (v.option3) validSizes.add(decodeHTML(v.option3).trim().toLowerCase());
        }
      });
      Array.from(selSizeEl.options).forEach(opt => {
        if (!opt.value) return;
        const optVal = decodeHTML(opt.value).trim().toLowerCase();
        if (validSizes.has(optVal)) {
          opt.disabled = false;
          opt.style.display = 'block';
        } else {
          opt.disabled = true;
          opt.style.display = 'none';
          if (opt.selected) {
            selSizeEl.value = '';
            if (comboSelections[itemIndex]) delete comboSelections[itemIndex].size;
          }
        }
      });
    }

    if (selectedSize && selColorEl) {
      const sVal = decodeHTML(selectedSize).trim().toLowerCase();
      const validColors = new Set();
      availVariants.forEach(v => {
        let vOpts = (v.options || []).map(o => decodeHTML(o).trim().toLowerCase());
        if (vOpts.some(o => o === sVal || o.includes(sVal))) {
          vOpts.forEach(o => validColors.add(o));
          if (v.option1) validColors.add(decodeHTML(v.option1).trim().toLowerCase());
          if (v.option2) validColors.add(decodeHTML(v.option2).trim().toLowerCase());
          if (v.option3) validColors.add(decodeHTML(v.option3).trim().toLowerCase());
        }
      });
      Array.from(selColorEl.options).forEach(opt => {
        if (!opt.value) return;
        const optVal = decodeHTML(opt.value).trim().toLowerCase();
        if (validColors.has(optVal)) {
          opt.disabled = false;
          opt.style.display = 'block';
        } else {
          opt.disabled = true;
          opt.style.display = 'none';
          if (opt.selected) {
            selColorEl.value = '';
            if (comboSelections[itemIndex]) delete comboSelections[itemIndex].color;
          }
        }
      });
    }
  }

  window.syncComboSizes = function() {
    const isChecked = document.getElementById('combo-sync-size-checkbox')?.checked;
    if (isChecked) {
      const size1 = document.getElementById('combo-size-1');
      if (size1 && size1.value) {
        const requiredCount = {{ combo_count }};
        for (let i = 2; i <= requiredCount; i++) {
          const targetSelect = document.getElementById('combo-size-' + i);
          if (targetSelect) {
            targetSelect.value = size1.value;
            if (!comboSelections[i]) comboSelections[i] = {};
            comboSelections[i].size = size1.value;
            updateDynamicAvailableOptions(i);
          }
        }
        validateCombo();
      }
    }
  };

  window.updateComboSelection = function(itemIndex, optionType, value) {
    if (!comboSelections[itemIndex]) {
      comboSelections[itemIndex] = {};
    }
    comboSelections[itemIndex][optionType] = value;
    updateDynamicAvailableOptions(itemIndex);
    
    if (itemIndex === 1 && optionType === 'size') {
      window.syncComboSizes();
    }
    
    validateCombo();
  };

  function validateCombo() {
    let allValid = true;
    let variantsDataEl = document.getElementById('ProductVariantsData');
    if(!variantsDataEl) return false;
    let variants = [];
    try {
      variants = JSON.parse(variantsDataEl.textContent);
    } catch(e) { return false; }
    
    const requiredCount = {{ combo_count }};
    const colorSelects = document.querySelectorAll('.combo-color-select');
    const sizeSelects = document.querySelectorAll('.combo-size-select');
    const hasColorSelect = colorSelects.length > 0 && colorSelects[0].options.length > 1;
    const hasSizeSelect = sizeSelects.length > 0 && sizeSelects[0].options.length > 1;
    
    for (let i = 1; i <= requiredCount; i++) {
      const sel = comboSelections[i];
      if(!sel) { allValid = false; break; }
      if(hasColorSelect && !sel.color) { allValid = false; break; }
      if(hasSizeSelect && !sel.size) { allValid = false; break; }
      
      let matchedVariant = variants.find(v => {
        let vOpts = (v.options || []).map(o => decodeHTML(o).trim().toLowerCase());
        let cVal = sel.color ? decodeHTML(sel.color).trim().toLowerCase() : null;
        let sVal = sel.size ? decodeHTML(sel.size).trim().toLowerCase() : null;

        let matchColor = !cVal || vOpts.some(o => o === cVal || o.includes(cVal));
        let matchSize = !sVal || vOpts.some(o => o === sVal || o.includes(sVal));
        return matchColor && matchSize;
      });

      // Fallback: If 1 option product or variants match by option1/option2 directly
      if (!matchedVariant && variants.length > 0) {
        if (!hasColorSelect && !hasSizeSelect) {
          matchedVariant = variants[0];
        } else if (!hasColorSelect && sel.size) {
          let sVal = decodeHTML(sel.size).trim().toLowerCase();
          matchedVariant = variants.find(v => (v.option1 || '').toLowerCase() === sVal || (v.option2 || '').toLowerCase() === sVal);
        } else if (!hasSizeSelect && sel.color) {
          let cVal = decodeHTML(sel.color).trim().toLowerCase();
          matchedVariant = variants.find(v => (v.option1 || '').toLowerCase() === cVal || (v.option2 || '').toLowerCase() === cVal);
        }
      }

      if (matchedVariant && matchedVariant.id) {
        comboSelections[i].variantId = matchedVariant.id;
      } else {
        allValid = false;
      }
    }

    const addBtn = document.getElementById('fit11ComboAddToCartBtn');
    const stickyAddBtn = document.getElementById('fit11StickyAddBtn');
    
    if(addBtn) {
      if (allValid) {
        addBtn.disabled = false;
        addBtn.style.opacity = '1';
        if(stickyAddBtn) { stickyAddBtn.disabled = false; stickyAddBtn.style.opacity = '1'; }
      } else {
        addBtn.disabled = true;
        addBtn.style.opacity = '0.5';
        if(stickyAddBtn) { stickyAddBtn.disabled = true; stickyAddBtn.style.opacity = '0.5'; }
      }
    }
    return allValid;
  }

  window.addComboToCart = async function(e) {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    if (!validateCombo()) {
      alert('Please select all required options before adding to cart.');
      return false;
    }

    const addBtn = document.getElementById('fit11ComboAddToCartBtn');
    if(addBtn) {
      if (addBtn.getAttribute('data-processing') === 'true') return false;
      addBtn.setAttribute('data-processing', 'true');
      
      const btnTextEl = addBtn.querySelector('.fit11-btn-text');
      const origText = btnTextEl ? btnTextEl.innerText : 'ADD TO CART';
      if(btnTextEl) btnTextEl.innerText = 'ADDING...';
      addBtn.disabled = true;
      addBtn.style.pointerEvents = 'none';

      try {
        const comboGroupId = Date.now().toString();
        const count = {{ combo_count }};
        const itemsToAdd = [];

        for (let i = 1; i <= count; i++) {
          const varId = comboSelections[i] ? comboSelections[i].variantId : null;
          if (!varId) {
            alert('One or more selected combinations are currently unavailable. Please pick different options.');
            if(btnTextEl) btnTextEl.innerText = origText;
            addBtn.disabled = false;
            addBtn.style.pointerEvents = 'auto';
            addBtn.setAttribute('data-processing', 'false');
            return false;
          }
          itemsToAdd.push({
            id: varId,
            quantity: 1,
            properties: {
              '_combo_id': comboGroupId,
              '_combo_required_count': count.toString(),
              '_combo_product_id': '{{ product.id }}',
              '_combo_item_index': i.toString()
            }
          });
        }

        const rootUrl = (window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/');
        const addUrl = rootUrl + 'cart/add.js?t=' + Date.now();

        // 1. Primary JSON Add Request
        let addRes = await fetch(addUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items: itemsToAdd })
        });
        
        // 2. Fallback: Form Encoded Add Request if JSON fails on mobile browser
        if (!addRes.ok) {
          try {
            const formPayload = new URLSearchParams();
            itemsToAdd.forEach((item, idx) => {
              formPayload.append(`items[${idx}][id]`, item.id);
              formPayload.append(`items[${idx}][quantity]`, item.quantity);
              if (item.properties) {
                for (let p in item.properties) {
                  formPayload.append(`items[${idx}][properties][${p}]`, item.properties[p]);
                }
              }
            });

            addRes = await fetch(addUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json'
              },
              body: formPayload.toString()
            });
          } catch(e) {}
        }

        if (!addRes.ok) {
          const errData = await addRes.json().catch(() => ({}));
          const errMsg = errData.description || errData.message || 'One or more selected items are currently out of stock.';
          alert(errMsg);
          throw new Error(errMsg);
        }

        const discountCode = '11FIT-COMBO-{{ product.id }}-{{ combo_count }}';
        window.location.href = rootUrl + 'discount/' + discountCode + '?redirect=/cart';

      } catch (err) {
        console.error('Combo cart add error:', err);
        if(btnTextEl) btnTextEl.innerText = 'UNAVAILABLE';
        setTimeout(() => {
          if(btnTextEl) btnTextEl.innerText = origText;
          addBtn.disabled = false;
          addBtn.style.pointerEvents = 'auto';
          addBtn.setAttribute('data-processing', 'false');
        }, 2000);
      }
    }
  };

  function onComboSelectChange(e) {
    const sel = e.target;
    if (!sel) return;
    const itemIndex = parseInt(sel.dataset.item);
    const optionType = sel.dataset.option;
    if (sel.value && sel.value !== '') {
      if (!comboSelections[itemIndex]) comboSelections[itemIndex] = {};
      comboSelections[itemIndex][optionType] = sel.value;
    }
    validateCombo();
  }

  function initComboSelectionsFromDOM() {
    let colorSelects = document.querySelectorAll('.combo-color-select');
    if (colorSelects.length > 0) {
      const availableColors = Array.from(colorSelects[0].options).filter(opt => opt.value !== '').map(opt => opt.value);
      colorSelects.forEach((sel, index) => {
        if (!sel.value && availableColors.length > 0) {
           sel.value = availableColors[index % availableColors.length];
        }
      });
    }

    document.querySelectorAll('.combo-select').forEach(function(sel) {
      const itemIndex = parseInt(sel.dataset.item);
      const optionType = sel.dataset.option;
      if (sel.value && sel.value !== '') {
        if (!comboSelections[itemIndex]) comboSelections[itemIndex] = {};
        comboSelections[itemIndex][optionType] = sel.value;
        updateDynamicAvailableOptions(itemIndex);
      }
      sel.removeEventListener('change', onComboSelectChange);
      sel.addEventListener('change', onComboSelectChange);
    });
    validateCombo();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComboSelectionsFromDOM);
  } else {
    initComboSelectionsFromDOM();
  }

  window.addEventListener('pageshow', function(event) {
    comboSelections = {};
    initComboSelectionsFromDOM();
  });
</script>
